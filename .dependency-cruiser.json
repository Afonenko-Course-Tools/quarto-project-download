{
  "forbidden": [
    {
      "name": "no-production-cycles",
      "severity": "error",
      "from": {
        "path": "^_extensions/project-download/",
        "pathNot": "(^|/)(node_modules|vendor|generated|_generated)(/|$)"
      },
      "to": {
        "circular": true,
        "viaOnly": {
          "dependencyTypesNot": ["type-only"]
        }
      }
    },
    {
      "name": "providers-use-public-api",
      "severity": "error",
      "from": {
        "path": "^_extensions/project-download/"
      },
      "to": {
        "path": "(?:^|/)(?:course-core|course-navigation|course-prairielearn|reference-catalog)/(?!public\\.ts$)"
      }
    }
  ],
  "options": {
    "doNotFollow": {
      "path": "(^|/)(node_modules|vendor|generated|_generated)(/|$)"
    },
    "exclude": "(^|/)(node_modules|vendor|generated|_generated)(/|$)",
    "tsPreCompilationDeps": true
  }
}
